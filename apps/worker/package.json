{
  "name": "@botfolio/worker",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": { "node": ">=20" },
  "exports": { "./runner": "./src/runner.ts" },
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsup",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:anvil": "RELAY_ANVIL=1 vitest run anvil --testTimeout=90000"
  },
  "dependencies": {
    "@botfolio/llm": "workspace:*",
    "@botfolio/shared": "workspace:*",
    "jose": "^6.2.0",
    "node-cron": "^4.6.0",
    "pg": "^8.16.0",
    "viem": "^2.58.4"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.0",
    "@types/node": "^20.19.43",
    "@types/pg": "^8.15.0",
    "tsup": "^9.0.0",
    "tsx": "^4.19.0",
    "typescript": "npm:@typescript/typescript6@6.0.2",
    "typescript-7": "npm:typescript@7.0.2",
    "vitest": "5.1.1"
  }
}
