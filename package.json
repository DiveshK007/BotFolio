{
  "name": "botfolio",
  "private": true,
  "packageManager": "pnpm@9.12.0",
  "engines": { "node": ">=20" },
  "scripts": {
    "build": "pnpm -r --if-present build",
    "typecheck": "pnpm -r --if-present typecheck",
    "test": "pnpm -r --if-present test",
    "lint": "pnpm -r --if-present lint",
    "replay": "pnpm --filter @botfolio/replay start"
  },
  "pnpm": {
    "overrides": {
      "next>postcss": "^8.5.18",
      "ws@>=8.0.0 <8.21.0": "^8.21.0"
    },
    "auditConfig": {
      "ignoreCves": ["CVE-2023-54404", "CVE-2026-118664"]
    }
  }
}
